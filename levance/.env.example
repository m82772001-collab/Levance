# ─────────────────────────────────────────────────────────────
# LÉVANCE — Environment Variables (placeholders only)
# Copy to .env.local and fill in real values. Never commit
# .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# --- Supabase (NEXT_PUBLIC_* are safe for the browser; RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Publishable key is safe for the browser.
STRIPE_PUBLISHABLE_KEY=
# Server-only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe Price IDs for membership subscriptions (server-only)
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# --- CJ Dropshipping (server-only) — official API 2.0 ---
# Docs: https://developers.cjdropshipping.com/en/api/api2/
# Auth: POST /api2.0/v1/authentication/getAccessToken with { "apiKey" }
# Header on subsequent calls: CJ-Access-Token
CJ_API_KEY=
# Optional override (default https://developers.cjdropshipping.com)
CJ_API_BASE_URL=
# Optional: persist refresh token across cold starts
CJ_REFRESH_TOKEN=
# Set to 1 to pass isSandbox=1 on createOrderV3
CJ_SANDBOX=0
# Retail markup over supplier cost (percent)
CJ_MARKUP_PERCENT=40
CJ_MARKUP_FIXED_CENTS=0
CJ_INCLUDE_SHIPPING_IN_PRICE=0

# Cron protection for /api/cron/cj/*
CRON_SECRET=
